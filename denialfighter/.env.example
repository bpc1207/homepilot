# Local development defaults (docker compose overrides these for containers).
DATABASE_URL=postgresql://denial:denial@localhost:5432/denialfighter
APP_URL=http://localhost:3000
NODE_ENV=development

# Dev-only master key (base64 32 bytes). Generate: openssl rand -base64 32
APP_MASTER_KEY=REPLACE_ME_WITH_openssl_rand_-base64_32
KEY_DRIVER=local
ALLOW_INSECURE_DEV=true  # never set in a deployed environment
# Production: KEY_DRIVER=kms and KMS_KEY_ID=arn:aws:kms:...

STORAGE_DRIVER=s3
S3_BUCKET=denialfighter-dev
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

MAIL_DRIVER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025

# Provider drivers (mock works offline). Real ones arrive in Phase 2.
OCR_DRIVER=mock
LLM_DRIVER=mock
LLM_MODEL=mock-model
